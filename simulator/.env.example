# Copia este archivo como "simulator/.env" (opcional: sin él se usan estos mismos valores).

# Dirección del broker MQTT embebido en el backend
MQTT_URL=mqtt://localhost:1883
# Dirección del backend (para subir fotos del sistema de seguridad por HTTP)
BACKEND_URL=http://localhost:3000
# Cantidad de juegos de dispositivos: 1 = cuna-01, colchon-01, ...; 2 = además cuna-02, ...
SIM_SETS=1
# Puerto del panel de control del simulador
PANEL_PORT=4300
# Clave para subir fotos al backend (debe ser igual a IOT_CLAVE de backend/.env)
IOT_CLAVE=clave-dispositivos-demo
