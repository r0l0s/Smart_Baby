# Copia este archivo como "backend/.env" y llena los valores. NUNCA subas .env a git.

# Puerto HTTP del backend (el frontend usa /api a través del proxy de Angular)
PORT=3000
# Puerto del broker MQTT embebido (los dispositivos se conectan aquí)
MQTT_PORT=1883

# Supabase → Project Settings → API Keys / Data API
# URL del proyecto, ej. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Clave "service_role" (secreta, da acceso total; solo el backend la usa)
SUPABASE_SERVICE_ROLE_KEY=

# Texto largo y aleatorio para firmar los JWT (ej. 64 caracteres al azar)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Telegram: créalo con @BotFather (/newbot). Token tipo 123456789:ABC-DEF...
TELEGRAM_BOT_TOKEN=
# Nombre de usuario del bot SIN "@", ej. SmartBabyTecBot
TELEGRAM_BOT_USERNAME=

# Modo demo: true = la cuna se consulta cada 10 s en vez de cada INTERVALO_CUNA_SEG
MODO_DEMO=true
# Intervalo real de consulta a la cuna (segundos), usado si MODO_DEMO=false
INTERVALO_CUNA_SEG=180
